      <ThenStepName>Trigger</ThenStepName>
      <ElseStepName>No Board</ElseStepName>
      <ParameterTypes>String</ParameterTypes>
      <InputString>DUT_IN</InputString>
      <StringBoolCharConditions>EqualsTo</StringBoolCharConditions>
      <IntDoubleByteConditions>EqualsTo</IntDoubleByteConditions>
      <AssignVaribaleFrom>GlobalVariable</AssignVaribaleFrom>
      <TargetIntDoubleByteStringChar>ON</TargetIntDoubleByteStringChar>
      <TargetGlobalVaribaleName>BOARD_PRESENT</TargetGlobalVaribaleName>
      <TargetBool>False</TargetBool>
      <InputStringTimer />
      <Name Metadata="Step Name">If Else</Name>
      <ChildTestSteps>
        <TestStep type="emb:Keysight.OpenTap.Plugins.Extensions.TapSteps.Advance_Steps.PrintStep" Id="66b1ef5f-6304-4c4a-9e22-37afd538de1a">
