            <Value>Inconclusive, Fail, Aborted, Error</Value>
            <IsEnabled>false</IsEnabled>
          </Ptem.ErrorHandlingMixin.ReportError>
          <Ptem.ErrorHandlingMixin.ErrorCode />
        </TestStep>
      </ChildTestSteps>
      <Ptem.Step.MemberProperties.MemberProperties />
      <Ptem.MultiUutLock.Enabled>false</Ptem.MultiUutLock.Enabled>
      <Ptem.ErrorHandlingMixin.ReportError>
        <Value>Inconclusive, Fail, Aborted, Error</Value>
        <IsEnabled>false</IsEnabled>
      </Ptem.ErrorHandlingMixin.ReportError>
      <Ptem.ErrorHandlingMixin.ErrorCode />
